# Copy to .env and fill in real values. NEVER commit .env.
# In production (Replit) set these in Replit Secrets instead.

# Database: sqlite | postgres
DB_DIALECT=sqlite
SQLITE_PATH=./.data/article-saver.sqlite
# Only used when DB_DIALECT=postgres
DATABASE_URL=postgres://article_saver:article_saver@localhost:5432/article_saver

# Blob storage: local | replit
BLOB_STORAGE=local
LOCAL_BLOB_DIR=./.data/uploads

# Clerk (https://dashboard.clerk.com) — placeholders only
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NUXT_CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@example.com
