# Copy to .env and fill in real values. NEVER commit .env.
# In production (Replit) set these in Replit Secrets instead.

# Database: postgres on Replit; sqlite is also available for local tests
DB_DIALECT=postgres
SQLITE_PATH=./.data/article-saver.sqlite
# Replit provides DATABASE_URL separately for development and production.
# For local PostgreSQL, use the compose.yaml credentials below.
DATABASE_URL=postgres://article_saver:article_saver@localhost:5432/article_saver

# Blob storage: local | replit
BLOB_STORAGE=local
LOCAL_BLOB_DIR=./.data/uploads

# Clerk (https://dashboard.clerk.com) — placeholders only
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NUXT_CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# Public origin of the app (scheme + host [+ port]); the CSRF check compares
# the Origin header to it. If unset, it is derived from the request's
# Host / X-Forwarded-* headers. Leave commented out for local dev.
# NUXT_PUBLIC_APP_ORIGIN=https://your-app.example.com

# Clerk Frontend API proxy (Replit production ONLY). Replit-managed Clerk's
# production FAPI host has no TLS cert, so the app proxies it at /__clerk.
# Set this in the production Replit Secrets. NEVER set it in development:
# Clerk proxies do not work for development instances.
# NUXT_PUBLIC_CLERK_PROXY_URL=https://your-app.replit.app/__clerk
